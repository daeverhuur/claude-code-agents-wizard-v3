{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {},
      "description": "Visual testing, screenshots, browser automation"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"],
      "env": {},
      "description": "Secure file operations with access controls"
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {},
      "description": "Knowledge graph-based persistent memory for project context"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "description": "Structured problem-solving through thought sequences"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<your-github-token>"
      },
      "description": "Repository management, PRs, issues, commits"
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "<your-connection-string>"
      },
      "description": "PostgreSQL database integration with query execution"
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "supabase-mcp-server"],
      "env": {
        "SUPABASE_URL": "<your-supabase-url>",
        "SUPABASE_SERVICE_KEY": "<your-service-key>"
      },
      "description": "Supabase project management, database operations, schema design"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp"],
      "env": {},
      "description": "Next.js dev tools: errors, logs, metadata, server actions"
    }
  }
}
